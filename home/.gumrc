#===🦆🦆🦆🦆🦆🦆🦆🦆🦆🦆🦆🦆🦆
# 🦆 says ⮞ GUM STYLE

export FOREGROUND="46" # 🦆 says ⮞ Bright green text
export BACKGROUND="0" # 🦆 says ⮞ Black background
export BORDER="rounded" # 🦆 says ⮞ Rounded border for a cool look
export BORDER_FOREGROUND="214" # 🦆 says ⮞ Orange border
export BORDER_BACKGROUND="0" # 🦆 says ⮞ Black background
export ALIGN="center" # 🦆 says ⮞ Center the text
export HEIGHT="3" # 🦆 says ⮞ Set height for better visibility
export WIDTH="40" # 🦆 says ⮞ Define width for a neat display
export MARGIN="1 1" # 🦆 says ⮞ Add some space around
export PADDING="1 2" # 🦆 says ⮞ Give text some breathing room
export BOLD="true" # 🦆 says ⮞ Make text bold
export ITALIC="true" # 🦆 says ⮞ Add style with italics
export UNDERLINE="true" # 🦆 says ⮞ Emphasize text with underline


